# rules：完全离线；deepseek：模型抽取失败时自动回退 rules
AI_PROVIDER=rules
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 生产默认 v1；v2 为严格实验版，需通过同数据集回归门禁后再切换
DEEPSEEK_PROMPT_VERSION=order-extraction-v1
# 可选：覆盖本地 Tesseract 路径；默认自动发现 .venv/tools/tesseract/tesseract.exe
TESSERACT_CMD=
# 按当前计费币种填写每百万 Token 单价；不配置时费用统计为 0
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0
# 本地 SQLite 任务队列：最大尝试次数与空闲轮询间隔（秒）
RECOGNITION_TASK_MAX_ATTEMPTS=3
RECOGNITION_TASK_POLL_INTERVAL=0.25
# Harness 编排：留空时继承 AI_PROVIDER；rules 可完全离线，deepseek 启用真实 Tool Calling
AGENT_HARNESS_PROVIDER=rules
AGENT_HARNESS_MAX_ROUNDS=6
AGENT_HARNESS_MAX_TOOL_CALLS=8
